spring:
  application:
    name: es-query-service
  cloud:
    nacos:
      server-addr: 127.0.0.1:8848
      namespace: public
      username: nacos
      password: nacos
      config:
        file-extension: yaml
        group: DEFAULT_GROUP
  # 必须是标量/逗号分隔形式：YAML 列表会展开成 spring.config.import[0]，
  # SCA 的 import-check 用 containsProperty 检测会误判为未配置
  config:
    import: optional:nacos:${spring.application.name}.yaml,optional:nacos:es-common.yaml

# 本地兜底配置（Nacos 上同名 dataId 的内容会覆盖这里）
es:
  nodes: localhost:9200
  scheme: http
  username: elastic
  password: ""
